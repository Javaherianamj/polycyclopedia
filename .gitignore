node_modules/
dist/
dist-ssr/
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store

# graphify knowledge-graph output (regenerable via /graphify)
graphify-out/

# Python (tools/etl one-shot migration tooling)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/

# Local database env
db/.env
api/.env
web/.env
web/.env.deploy

# Neon connection strings, written by `neon env pull`. The .neon context file
# itself is safe to commit (org/project ids only); these are not.
.env
.env.local
.env*.local

# Curation working files. These are generated by tools/curation/export_gaps.py
# / export_workbook.py and filled in by hand; they are a scratchpad, not
# source. Committing them would invite someone to treat a half-filled
# spreadsheet as authoritative.
curation/*.csv
curation/*.xlsx

# Obsidian vault config — per-user editor state, not project source
.obsidian/

# Astro's cache directory (web/) — generated types and dev metadata
.astro/

#dns and ssl data
_acme-challenge.polycyclopedia.ir.txt
db/backups/

# FE-5 property-search build-time index — generated by web/scripts/, a build
# artifact re-derived from the database on every build, not source.
web/public/search-*.json
