# Copy to api/.env and edit. api/.env is gitignored and must never be committed.
#
# Variable names for the database connection intentionally match
# db/.env.example so a single set of values configures both the database
# container and this API.
#
# Neon note (2026-08-12): the project's database is moving to Neon (managed
# Postgres) going forward, but that migration is not done yet -- the Neon
# branch has no schema applied and this API still only understands the
# discrete DB_HOST/POSTGRES_PORT/POSTGRES_DB/APP_DB_USER/APP_DB_PASSWORD
# variables below, not a single DATABASE_URL connection string (Neon's own
# format, written to repo-root .env.local by `neon env pull`). Until
# api/src/config.ts is updated to accept DATABASE_URL, point these variables
# at the local Docker Postgres in db/docker-compose.yml, same as always. See
# db/README.md "Neon is the database, going forward" for the full picture.

# --- Database connection (read-only role) -----------------------------------
# The API MUST connect as APP_DB_USER (polypedia_app), never as POSTGRES_USER
# (the schema owner). polypedia_app cannot run DDL, so an injection or logic
# bug in this API cannot drop a table.
DB_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DB=polypedia
APP_DB_USER=polypedia_app
APP_DB_PASSWORD=change_me_local_only_too

# Pool size
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# --- HTTP server --------------------------------------------------------------
PORT=3001
HOST=0.0.0.0

# Comma-separated list of allowed CORS origins. Empty = no cross-origin
# requests allowed.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4321

# --- Query limits ---------------------------------------------------------
# Default and hard-cap page size for list endpoints. Requests asking for more
# than LIMIT_MAX are silently clamped, never rejected.
LIMIT_DEFAULT=50
LIMIT_MAX=200
