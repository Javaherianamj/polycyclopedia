# Copy to db/.env and edit. db/.env is gitignored and must never be committed.
#
# These are LOCAL DEVELOPMENT values. Production credentials are managed
# out-of-band and must not live in this repository.

POSTGRES_USER=polypedia
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=polypedia
POSTGRES_PORT=55432

# Least-privilege role used by the application at runtime.
# This role can read and write data but cannot run DDL -- so an application
# bug or injection cannot drop a table. Migrations run as POSTGRES_USER.
APP_DB_USER=polypedia_app
APP_DB_PASSWORD=change_me_local_only_too
