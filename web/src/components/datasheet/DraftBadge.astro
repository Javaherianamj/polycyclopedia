---
// Renders only for materials the database has not marked `published`.
// See lib/publish.ts for why this exists and why the build-time gate that
// shares its module is off by default.
import type { Locale } from '../../i18n/config';
import { isPublished } from '../../lib/publish';
import { t } from '../../i18n/t';

interface Props {
  status: string;
  locale: Locale;
}

const { status, locale } = Astro.props;
---

{
  !isPublished(status) && (
    <p class="draft-badge" data-testid="datasheet-draft-badge">
      <strong>{t(locale, 'datasheet.draft.label')}</strong>
      <span>{t(locale, 'datasheet.draft.note')}</span>
    </p>
  )
}
