---
// FE-6: compare (D24/D25-equivalent, R13). Subject picker + application
// picker need JS immediately, same `client:load` posture SearchIsland took.
// `?add=` is read here server/build-side for forward-compatibility with an
// eventual adapter, same R23 caveat SearchIsland's `prefillSlug` documents
// -- CompareIsland falls back to reading `location.search` itself, which is
// what actually fires it under this project's static build today.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompareIsland from '../../islands/CompareIsland';
import { t } from '../../i18n/t';

const locale = 'en' as const;
const addParam = Astro.url.searchParams.get('add') ?? undefined;
const addSlugs = addParam ? addParam.split(',').filter((s) => s !== '') : [];
---

<BaseLayout locale={locale} title={t(locale, 'datasheet.quickCompare')}>
  <main class="wrap cmp-wrap">
    <h1>{t(locale, 'datasheet.quickCompare')}</h1>
    <p class="cmp-lead">{t(locale, 'compare.pageLead')}</p>
    <CompareIsland client:load locale={locale} addSlugs={addSlugs} />
  </main>
</BaseLayout>

<style>
  .cmp-wrap {
    max-inline-size: var(--measure-page, 1120px);
    margin-inline: auto;
    padding: var(--sec-gap) var(--pad-x) 60px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h1);
    margin-block-end: 10px;
  }
</style>
