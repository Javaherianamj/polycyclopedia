{
  "name": "@polypedia/web",
  "private": true,
  "version": "0.1.0",
  "description": "Polypedia frontend — Astro app shell (FE-1). The frozen prototype at the repo root is a content reference only (R21); this is the shipping frontend.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "build:search-index": "tsx scripts/build-search-index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "astro": "^7.1.6",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
